generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Service {
  id              String        @id @default(uuid())
  name            String
  category        String
  description     String
  durationMinutes Int
  priceRange      String
  iconName        String
  appointments    Appointment[]
}

model Dentist {
  id              String        @id @default(uuid())
  name            String
  title           String
  specialization  String
  experienceYears Int
  bio             String
  availableDays   String
  avatarUrl       String
  appointments    Appointment[]
}

model Appointment {
  id           String   @id @default(uuid())
  serviceId    String
  service      Service  @relation(fields: [serviceId], references: [id])
  dentistId    String
  dentist      Dentist  @relation(fields: [dentistId], references: [id])
  patientName  String
  patientEmail String
  patientPhone String
  notes        String?
  date         String
  timeSlot     String
  status       String   @default("CONFIRMED")
  createdAt    DateTime @default(now())
}
